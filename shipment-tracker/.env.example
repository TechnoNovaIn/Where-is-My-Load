# Balaji Transports API service account (server-side only; rotate if ever exposed)
UPSTREAM_USERNAME=
UPSTREAM_PASSWORD=

# 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# SQLite for a single box, or Postgres: postgresql+asyncpg://user:pass@host:5432/tracker
DATABASE_URL=sqlite+aiosqlite:///./data/tracker.db

# Keep true in production (HTTPS). Set false only for local http testing.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Exactly one process should poll the upstream API
RUN_POLLER=true
LOCATION_POLL_SECONDS=60
SHIPMENT_POLL_SECONDS=120
LOOKBACK_DAYS=10

GPS_STALE_MINUTES=30
DELIVERED_VISIBLE_DAYS=90
TRAIL_RETENTION_DAYS=30

# Ola Maps API key (https://maps.olakrutrim.com -> Dashboard -> API keys).
# Stays on the server; the browser loads map tiles through /olamaps/ on this site.
OLA_MAPS_API_KEY=
# Optional style names (add a language suffix such as -hi or -kn for local labels)
OLA_STYLE_LIGHT=default-light-standard
OLA_STYLE_DARK=default-dark-standard
